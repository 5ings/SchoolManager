@model SchoolManager.ViewModels.School.SchoolCreateViewModel

<h1>Добавяне на училище</h1>

<form asp-action="Create" method="post">

    <label>Име на училище</label>
    <input asp-for="Name" />
    <span asp-validation-for="Name"></span>

    <br />
    <br />

    <label>Адрес:</label>
    <input asp-for="Address" />
    <span asp-validation-for="Address"></span>

    <br />
    <br />

    <label>Телефонен номер:</label>
    <input asp-for="PhoneNumber" />
    <span asp-validation-for="PhoneNumber"></span>

    <br />
    <br />

    <label>Имейл:</label>
    <input asp-for="Email" />
    <span asp-validation-for="Email"></span>

    <br />
    <br />

    <label>Брой стаи:</label>
    <input asp-for="RoomsCount" />
    <span asp-validation-for="RoomsCount"></span>

    <br />
    <br />

    <button type ="submit">Запази</button>
</form>

<a asp-action="Index">Назад към списъка</a>


<br />

<a href="/School/Index">Покажи всички училища</a>
