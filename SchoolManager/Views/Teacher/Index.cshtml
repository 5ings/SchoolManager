@model IEnumerable<SchoolManager.ViewModels.Teacher.TeacherIndexViewModel>

@{
    ViewData["Title"] = "Учители";
}

<h1>Учители</h1>

<p>
    <a asp-action="Create">Създай нов учител</a> |
    <a asp-controller="School" asp-action="Index">Виж училища</a> |
    <a asp-controller="Student" asp-action="Index">Виж ученици</a>
</p>

<div class="row mb-3">
    <div class="col-md-3">
        <label class="form-label">Име на учител</label>
        <input type="text" id="search"
               class="form-control"
               placeholder="Търси по име..." />
    </div>

    <div class="col-md-3">
        <label class="form-label">Предмет</label>
        <input type="text" id="subject"
               class="form-control"
               placeholder="Въведи предмет..." />
    </div>

    <div class="col-md-3">
        <label class="form-label">Подреди по</label>
        <select id="sortOrder" class="form-control">
            <option value="name_asc">Име А-Я</option>
            <option value="name_desc">Име Я-А</option>
            <option value="subject">Предмет А-Я</option>
        </select>
    </div>

    <div class="col-md-3 d-flex align-items-end">
        <button type="button" id="clearFilters"
                class="btn btn-secondary">
            Изчисти филтрите
        </button>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Subject)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SchoolName)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody id="teachersTable">
        @foreach (var teacher in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => teacher.FirstName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => teacher.LastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => teacher.Subject)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => teacher.SchoolName)
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@teacher.Id">
                        Редактирай
                    </a>
                    |
                    <a asp-action="Details"
                       asp-route-id="@teacher.Id">
                        Детайли
                    </a>
                    |
                    <a asp-action="Delete"
                       asp-route-id="@teacher.Id">
                        Изтрий
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="~/js/TeacherFile.js"
            asp-append-version="true"></script>
}
